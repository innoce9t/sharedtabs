{
  "manifest_version": 3,
  "name": "SharedTabs",
  "version": "0.8.2",
  "description": "Let AI agents on your computer use only the Chrome tabs you share, on sites you allow. Works with any local MCP agent.",
  "key": "",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "webNavigation",
    "debugger",
    "nativeMessaging",
    "storage",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SharedTabs"
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
